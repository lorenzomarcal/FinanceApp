# Copie este arquivo para .env e preencha os valores.
# NUNCA suba o .env para o GitHub.

# Sequência longa e aleatória que assina o login.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Token gratuito obtido em https://brapi.dev
BRAPI_TOKEN=

# Use 1 só durante o desenvolvimento
FLASK_DEBUG=0
